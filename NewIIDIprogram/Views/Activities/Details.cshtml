@model NewIIDIprogram.Models.Activity

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<div>
    <h4>Activity</h4>
    <hr />
    <dl class="dl-horizontal">

        <dt>
            Step
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ProgramStep.StepTitle)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ActivityName)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ActivityName)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DoneBy)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DoneBy)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ActivityDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ActivityDate)
        </dd>

        <!-- NEW FIELDS -->

        <dt>Target</dt>
        <dd>@Html.DisplayFor(model => model.Target)</dd>

        <dt>Benefit</dt>
        <dd>@Html.DisplayFor(model => model.Benefit)</dd>

        <dt>Duration</dt>
        <dd>
            @if (Model.Duration != null)
            {
                @Model.Duration <text> mins</text>
            }
        </dd>

        <dt>Pricing</dt>
        <dd>
            @if (Model.Pricing != null)
            {
                <text>₹ @Model.Pricing</text>
            }
        </dd>

    </dl>
</div>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.ActivityId }) |
    @Html.ActionLink("Back to List", "Index", new { stepId = Model.StepId })
</p>