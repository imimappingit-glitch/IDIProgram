@model IEnumerable<NewIIDIprogram.Models.Activity>

@{
    ViewBag.Title = "Index";
    var role = Session["Role"]?.ToString();
}

<h2>Activity</h2>

@if (role == "Admin")
{
    <p>
        @Html.ActionLink(
         "Create Activity",
         "Create",
         "Activities",
         new { stepId = ViewBag.CurrentStepId },
         new { @class = "btn btn-primary" }
        )
    </p>
}

<div style="overflow-x:auto;">
    <table class="table table-striped table-bordered">
        <tr>
            <th>Step</th>
            <th>Activity Name</th>
            <th>Done By</th>
            <th>Date</th>
            <th>Target</th>
            <th>Benefit</th>
            <th>Duration</th>
            <th>Pricing</th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProgramStep.StepTitle</td>
                <td>@item.ActivityName</td>
                <td>@item.DoneBy</td>
                <td>@item.ActivityDate.ToString("yyyy-MM-dd")</td>

                <td style="max-width:200px; white-space:normal;">
                    @item.Target
                </td>

                <td style="max-width:200px; white-space:normal;">
                    @item.Benefit
                </td>

                <td>@(item.Duration != null ? item.Duration + " mins" : "")</td>

                <td>@(item.Pricing != null ? "₹ " + item.Pricing : "")</td>

                <td>
                    @if (role == "Admin")
                    {
                        @Html.ActionLink(" ", "Edit", new { id = item.ActivityId },
                            new { @class = "fa fa-edit edit", title = "Edit" })

                        @Html.ActionLink(" ", "Details", new { id = item.ActivityId },
                            new { @class = "fa fa-eye view", title = "Details" })

                        @Html.ActionLink(" ", "Delete", new { id = item.ActivityId },
                            new
                            {
                                @class = "fa fa-trash delete",
                                title = "Delete",
                                onclick = "return confirm('Are you sure?')"
                            })
                    }
                </td>
            </tr>
        }
    </table>
</div>