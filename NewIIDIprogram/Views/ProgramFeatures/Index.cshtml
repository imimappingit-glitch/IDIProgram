@model IEnumerable<NewIIDIprogram.Models.ProgramFeature>

@{
    ViewBag.Title = "Index";
}

<h2>Program Features</h2>

<p>
    @Html.ActionLink("Create New", "Create", new { clientId = ViewBag.ClientId })

</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FeatureTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FeatureDescription)
        </th>
        @*<th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>*@
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FeatureTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FeatureDescription)
            </td>
            @*<td>
                    @Html.DisplayFor(modelItem => item.UserId)
                </td>*@
            <td class="action-icons">
                @Html.ActionLink(" ", "Edit", new { id = item.FeatureId }, new { @class = "fa fa-edit edit", title = "Edit" })
                @Html.ActionLink(" ", "Details", new { id = item.FeatureId }, new { @class = "fa fa-eye view", title = "Details" })
                @Html.ActionLink(" ", "Delete", new { id = item.FeatureId }, new { @class = "fa fa-trash delete", title = "Delete", onclick = "return confirm('Are you sure?')" })
            </td>
        </tr>
    }

</table>
