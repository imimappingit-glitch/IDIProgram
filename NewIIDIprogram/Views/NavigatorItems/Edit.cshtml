@model NewIIDIprogram.Models.NavigatorItem

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>NavigatorItem</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ItemId)

        <div class="form-group">
            @Html.LabelFor(model => model.ItemTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.ItemTitle, new SelectList(new List<string>
                {
                    "Celebrations",
                    "Topics",
                    "Resources",
                    "Methods",
                    "Customised Home Resources Planning",
                    "Fine Motor Skills",
                    "Gross Motor Skills",
                    "Creativity",
                    "Toy Library Based on Innate",
                    "Visual Perception",
                    "Bansi",
                    "Value ED",
                    "Math Skills",
                    "Big Experiential Learning",
                    "E & A Kits"
                }), "Select Item Title", new { @class = "form-control" })

                @Html.ValidationMessageFor(model => model.ItemTitle, "", new { @class = "text-danger" })
            </div>
        </div>


        <div class="form-group">
            @Html.LabelFor(model => model.ItemDescription, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ItemDescription, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ItemDescription, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
