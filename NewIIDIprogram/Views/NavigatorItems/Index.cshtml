@model IEnumerable<NewIIDIprogram.Models.NavigatorItem>

@{
    ViewBag.Title = "Index";
}

<h2>Navigator Items</h2>

<p>
    @Html.ActionLink("Create New", "Create", new { clientId = ViewBag.ClientId })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.ItemTitle)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ItemDescription)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ItemTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ItemDescription)
            </td>
            <td class="action-icons">
                @Html.ActionLink(" ", "Edit", new { id = item.ItemId, clientId = ViewBag.ClientId }, new { @class = "fa fa-edit edit", title = "Edit" })
                @Html.ActionLink(" ", "Details", new { id = item.ItemId, clientId = ViewBag.ClientId }, new { @class = "fa fa-eye view", title = "Details" })
                @Html.ActionLink(" ", "Delete", new { id = item.ItemId, clientId = ViewBag.ClientId }, new { @class = "fa fa-trash delete", title = "Delete", onclick = "return confirm('Are you sure?')" })
            </td>
        </tr>
    }

</table>
