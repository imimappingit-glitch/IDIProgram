@model NewIIDIprogram.Models.ProgramStep

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>ProgramStep</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.ProgramId, "Program Name", htmlAttributes: new { @class = "control-label" })

            @Html.DropDownListFor(
                model => model.ProgramId,    // ✅ CORRECT
                (SelectList)ViewBag.ProgramId,
                "-- Select Program --",
                new { @class = "form-control" }
            )

            @Html.ValidationMessageFor(model => model.ProgramId)
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.StepTitle, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(
                    model => model.StepTitle,
                    (SelectList)ViewBag.StepTitle,
                    "-- Select Step --",
                    new { @class = "form-control" }
                )
                @Html.ValidationMessageFor(model => model.StepTitle, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            @Html.LabelFor(model => model.StepDescription, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.StepDescription, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.StepDescription, "", new { @class = "text-danger" })
            </div>
        </div>







        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
