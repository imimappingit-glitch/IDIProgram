@model NewIIDIprogram.Models.ProgramStep

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>ProgramStep</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.StepId)
        <div class="form-group">
            @Html.LabelFor(model => model.ProgramId, "Program Name", htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(
         m => m.ProgramId,
         ViewBag.ProgramId as SelectList,
         new { @class = "form-control" }
        )

            @Html.ValidationMessageFor(model => model.ProgramId)
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.StepTitle, new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.DropDownListFor(
                    m => m.StepTitle,
                    ViewBag.StepList as SelectList,
                    "-- Select Step --",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(m => m.StepTitle, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            @Html.LabelFor(model => model.StepDescription, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.StepDescription, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.StepDescription, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
