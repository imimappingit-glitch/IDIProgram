@model IEnumerable<NewIIDIprogram.Models.GetInTouch>

@{
    ViewBag.Title = "Index";
}

<h2>Get In Touches</h2>

<p>
    @Html.ActionLink("Create New", "Create", new { clientId = ViewBag.ClientId })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Mobile)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Message)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mobile)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Message)
            </td>
            <td class="action-icons">
                @Html.ActionLink(" ", "Edit", new { id = item.Id }, new { @class = "fa fa-edit edit", title = "Edit" })
                @Html.ActionLink(" ", "Details", new { id = item.Id }, new { @class = "fa fa-eye view", title = "Details" })
                @Html.ActionLink(" ", "Delete", new { id = item.Id }, new { @class = "fa fa-trash delete", title = "Delete", onclick = "return confirm('Are you sure?')" })
            </td>
        </tr>
    }

</table>
