<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />



    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <ul class="ios-menu">
            @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
            {
                <li class="ios-item"><a href="@Url.Action("Index", "LoginUsers")">Users</a></li>
                <li class="ios-item"><a href="@Url.Action("Index", "Programs")">Programs</a></li>
                @*<li class="ios-item"><a href="@Url.Action("Index", "Clients")">Clients</a></li>*@
                <li class="ios-item"><a href="@Url.Action("Index", "MasterSteps")">Master Steps</a></li>
                <li class="ios-item"><a href="@Url.Action("Index", "ClientInformations")">Client Profile</a></li>
                @*<li class="ios-item"><a href="@Url.Action("Index", "Programs")">Programs</a></li>
                    <li class="ios-item"><a href="@Url.Action("Index", "ProgramSteps")">Program Steps</a></li>*@

            }
            else if (Session["Role"] != null && Session["Role"].ToString() == "User")
            {
                <li class="ios-item"><a href="@Url.Action("Index", "Programs")">Programs</a></li>
            }
        </ul>
    </aside>



    <!-- TOP NAVIGATION -->
    <div class="top-nav">
        <button id="hamburger" class="hamburger-btn">
            <i class="fas fa-bars"></i>
        </button>

        @if (Session["UserName"] != null)
        {
            <span class="navbar-user">Welcome, @Session["UserName"]!</span>

            <form action="@Url.Action("Logout", "LoginUsers")" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">
                    Logout
                </button>
            </form>
        }
        else
        {
            <a href="@Url.Action("Login", "LoginUsers")">Login</a>
        }
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()

        @*<footer>
                <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
            </footer>*@
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const hamburger = document.getElementById("hamburger");
            const topNav = document.querySelector(".top-nav");
            const mainContent = document.querySelector(".main-content");

            hamburger.addEventListener("click", function () {
                if (window.innerWidth <= 992) {
                    sidebar.classList.toggle("mobile-show");
                } else {
                    sidebar.classList.toggle("collapsed");
                    topNav.classList.toggle("collapsed");
                    mainContent.classList.toggle("collapsed");
                }
            });
        });
    </script>




</body>
</html>
