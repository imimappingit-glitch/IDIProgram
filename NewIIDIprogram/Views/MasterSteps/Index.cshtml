@model IEnumerable<NewIIDIprogram.Models.MasterStep>

@{
    ViewBag.Title = "Index";
}

<h2>Master Step</h2>

<p>
    @Html.ActionLink("Create Master Step", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.StepTitle)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StepTitle)
            </td>
            <td class="action-buttons">
                @Html.ActionLink("Edit", "Edit", new { id = item.MasterStepId },
                    new { @class = "btn-action btn-edit", title = "Edit" })

                @Html.ActionLink("Details", "Details", new { id = item.MasterStepId },
                    new { @class = "btn-action btn-view", title = "Details" })

                @Html.ActionLink("Delete", "Delete", new { id = item.MasterStepId },
                    new
                        {
                        @class = "btn-action btn-delete",
                        title = "Delete",
                        onclick = "return confirm('Are you sure?')"
                    })
            </td>

        </tr>
    }

</table>

<style>
    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        color: #fff;
        transition: all 0.2s ease-in-out;
    }

    .btn-edit {
        background-color: #00c6e8;
    }

        .btn-edit:hover {
            background-color: #00a8c6;
        }

    .btn-view {
        background-color: #198754;
    }

        .btn-view:hover {
            background-color: #157347;
        }

    .btn-delete {
        background-color: #ffc107;
        color: #000;
    }

        .btn-delete:hover {
            background-color: #e0a800;
        }
</style>
