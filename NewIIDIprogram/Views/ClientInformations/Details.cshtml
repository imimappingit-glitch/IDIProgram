<!-- The Modal -->
<div id="myModal" class="modal">
    <span class="close" onclick="closeModal()">&times;</span>
    <img class="modal-content" id="modalImage">

    <div class="fields">
        <div class="field">
            <input type="hidden" id="biomatricLogId" name="biomatricLogId">
            <input type="hidden" id="Hand" name="Hand">
            <input type="hidden" id="FingerType" name="FingerType">
            <label for="lrc">LRC</label>
            <input type="text" id="lrc" placeholder="Enter LRC">

        </div>
        <div class="field">
            <label for="rrc">RRC</label>
            <input type="text" id="rrc" placeholder="Enter RRC">
        </div>
        <div class="field">
            <label for="FingerType">Finger Type</label>
            @Html.DropDownList("FingerTypeL1",
                ViewBag.FingerTypeL1 as List<SelectListItem> ?? new List<SelectListItem>(),
                "-- Select --",
                new { @class = "form-control" })
        </div>
        <button type="button" onclick="editRecord()">Edit</button>
    </div>
</div>


<script>
 function openModal(src, biomatricLogId, hand, fingerType) {
    var modal = document.getElementById("myModal");
    var modalImg = document.getElementById("modalImage");
    modal.style.display = "block";
    modalImg.src = src;

    $.ajax({
        url: '@Url.Action("GetFingerRecord", "ClientInformations")',
        type: "GET",
        dataType: "json", // 👈 Very important
        data: { biomatricLogId: biomatricLogId, hand: hand, fingerType: fingerType },
        success: function (data) {
            console.log("Response:", data); // Check output in console

            if (data && data.FingerTypeList) {
                $("#biomatricLogId").val(data.BiomatricLogId);
                $("#Hand").val(data.Hand);
                $("#FingerType").val(data.FingerType);
                $("#lrc").val(data.LRC);
                $("#rrc").val(data.RRC);

                var ddl = $("#FingerTypeL1");

                // Clear dropdown and add default first option
                ddl.empty().append($("<option>").val("").text("-- Select --"));

                // Populate dropdown from server list
                $.each(data.FingerTypeList, function (i, item) {
                    ddl.append($("<option>").val(item.Value).text(item.Text));
                });

                // ✅ Set selected value; if null/empty, first option stays selected
                ddl.val(data.SelectedFingerType || "");
            } else {
                console.warn("No FingerTypeList found in response:", data);
            }
        },
        error: function (xhr, status, err) {
            console.error("AJAX error:", err);
            alert("Error while loading finger record.");
        }
    });
}




    function closeModal() {
        var modal = document.getElementById("myModal");
        modal.style.display = "none";
    }

    window.onclick = function (event) {
        var modal = document.getElementById("myModal");
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>

