@model NewIIDIprogram.Models.ClientInformation

@{
    ViewBag.Title = "Details";
}

 

<h2>Details</h2>

<script>
function editRecord() {
    const id = $("#biomatricLogId").val();
    const hand = $("#Hand").val();
    const fingerType = $("#FingerType").val();

    const lrc = $("#lrc").val();
    const rrc = $("#rrc").val();

    // ✅ get selected finger type from dropdown
    const ftype = $("#FingerTypeL1").val();

    $.ajax({
        url: '@Url.Action("UpdateFingerprint", "ClientInformations")',
        type: 'POST',
        data: {
            biomatricLogId: id,
            hand: hand,
            fingerType: fingerType,
            lrc: lrc,
            rrc: rrc,
            ftype: ftype
        },
        success: function (res) {
            if (res.success) {
                alert("Fingerprint updated successfully");
                closeModal();
            } else {
                alert("Update failed: " + (res.message || "Unknown error"));
            }
        },
        error: function () {
            alert("Error while updating fingerprint");
        }
    });
}



</script>
