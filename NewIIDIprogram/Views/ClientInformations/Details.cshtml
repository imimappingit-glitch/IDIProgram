            @using System.Collections.Generic
            @functions {
                // Safe method to get position name with full null checking
                public string GetPositionName(int? position)
                {
                    try
                    {
                        if (!position.HasValue) return "Position";

                        switch (position.Value)
                        {
                            case 1: return "Center";
                            case 2: return "Left";
                            case 3: return "Right";
                            default: return "Position";
                        }
                    }
                    catch
                    {
                        return "Position";
                    }
                }
            }

            @{
                // Safely get the fingerprint list or empty list if null
                var fingerprints = Model.Fingureprits ?? new List<NewIIDIprogram.Models.BiomatricFingerprintMapping>();


                ;
