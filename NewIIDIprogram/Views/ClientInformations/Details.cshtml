    <!DOCTYPE html>
    <html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

        <style>
            /* Modal (background) */
            .modal {
                display: none;
                position: fixed;
                z-index: 1000;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                overflow-y: auto; /* allow scroll */
                background-color: rgba(0, 0, 0, 0.8);
                padding: 40px 0; /* spacing */
            }

            /* Modal Content */
            .modal-content {
                position: relative;
                background-color: #f2f2f2;
                margin: auto;
                padding: 15px;
                width: 90%;
                max-width: 600px;
                border-radius: 6px;
                text-align: center;
            }

                /* Image inside modal */
                .modal-content img {
                    max-width: 100%; /* scale width */
                    height: auto; /* no height restriction */
                    margin-bottom: 12px;
                    border: 2px solid #000;
                }

            /* Rotate image upright */
            #modalImage {
                transform: rotate(180deg);
            }

            .fields {
                background: #fff;
                padding: 12px;
                border-radius: 6px;
                text-align: left; /* labels + inputs aligned left */
                max-width: 600px;
                width: 100%;
                margin: 0 auto; /* centers the block horizontally */
                position: relative;
            }

            .field {
                margin: 10px 0;
            }

                .field label {
                    display: block;
                    font-size: 14px;
                    font-weight: bold;
                    margin-bottom: 4px;
                }

                .field input {
                    width: 20%;
                    padding: 6px;
                    font-size: 14px;
                }

            /* Button */
            button {
                margin-top: 10px;
                padding: 8px 16px;
                background: #007bff;
                color: #fff;
                border: none;
                border-radius: 4px;
                cursor: pointer;
            }

                button:hover {
                    background: #0056b3;
                }

            /* Close Button */
            .close {
                color: #fff;
                position: fixed; /* stays visible while scrolling */
                top: 20px;
                right: 35px;
                font-size: 40px;
                font-weight: bold;
                cursor: pointer;
                z-index: 1100;
                transition: color 0.3s, transform 0.3s;
            }

                .close:hover {
                    color: #ccc;
                    transform: scale(1.1);
                }
        </style>



    </head>
